# API (NestJS) del ERP. Corre con su propio usuario de Linux (erpjerk).
# Instalar: sudo cp deploy/erp-jerkhome-api.service /etc/systemd/system/
[Unit]
Description=ERP Jerkhome - API
After=network.target docker.service

[Service]
Type=simple
User=erpjerk
Group=erpjerk
WorkingDirectory=/home/erpjerk/erp-jerkhome/apps/api
EnvironmentFile=/home/erpjerk/erp-jerkhome/.env
ExecStart=/usr/bin/env node dist/main.js
Restart=always
RestartSec=5
# Seguridad: no puede escribir fuera de su carpeta
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/erpjerk/erp-jerkhome
PrivateTmp=true

[Install]
WantedBy=multi-user.target