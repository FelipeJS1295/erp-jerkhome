# ============================================================
#  .env de PRODUCCIÓN (VPS) — copiar a /home/erpjerk/erp-jerkhome/.env
#  Cambia TODO lo que dice CAMBIAR. Nunca subas este archivo a GitHub.
# ============================================================

# Docker: nombre propio para que no choque con otros proyectos del VPS
COMPOSE_PROJECT_NAME=erp-jerkhome

# Base de datos (contenedor propio, solo en 127.0.0.1)
POSTGRES_PORT=5440
POSTGRES_USER=erp
POSTGRES_PASSWORD=CAMBIAR-clave-larga-de-la-base
POSTGRES_DB=erp
# Debe calzar con los 4 valores de arriba
DATABASE_URL=postgres://erp:CAMBIAR-clave-larga-de-la-base@127.0.0.1:5440/erp

# Puertos internos (Nginx los publica en https://erp.jerkhome.cl)
API_PORT=4100
WEB_PORT=3100

# Dominio
WEB_ORIGIN=https://erp.jerkhome.cl
NEXT_PUBLIC_API_URL=https://erp.jerkhome.cl/api

# Sesiones: genera el secreto con   openssl rand -base64 48
AUTH_SECRET=CAMBIAR
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR-clave-del-admin-inicial
SESSION_DAYS=7
COOKIE_SECURE=true

NODE_ENV=production